-- Local mirror of the server tables (planning/04-sync-engine.md §2). Columns as on the server: money as INT
-- minor units, jsonb as TEXT JSON, timestamps as TEXT ISO-8601 (as the server sent them), numeric fx rates as
-- TEXT (never floating point). sync_state: 'synced' | 'pending' | 'failed'.

CREATE TABLE profiles (
  id TEXT NOT NULL PRIMARY KEY,
  display_name TEXT NOT NULL,
  avatar_path TEXT,
  upi_id TEXT,
  default_currency TEXT NOT NULL DEFAULT 'INR',
  updated_at TEXT,
  deleted_at TEXT,
  seq INT NOT NULL DEFAULT 0
) AS LocalProfile;

CREATE TABLE "groups" (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  type TEXT NOT NULL DEFAULT 'other',
  main_currency TEXT NOT NULL DEFAULT 'INR',
  cover_kind TEXT NOT NULL DEFAULT 'generated',
  cover_path TEXT,
  simplify_debts BOOLEAN NOT NULL DEFAULT FALSE,
  default_split TEXT,
  invite_code TEXT,
  archived_at TEXT,
  direct_key TEXT,
  created_at TEXT,
  created_by TEXT,
  updated_at TEXT,
  updated_by TEXT,
  client_updated_at TEXT,
  deleted_at TEXT,
  deleted_by TEXT,
  seq INT NOT NULL DEFAULT 0,
  sync_state TEXT NOT NULL DEFAULT 'synced'
) AS LocalGroup;

CREATE TABLE group_members (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  user_id TEXT,
  display_name TEXT NOT NULL,
  position INT NOT NULL DEFAULT 0,
  role TEXT NOT NULL DEFAULT 'member',
  status TEXT NOT NULL DEFAULT 'active',
  claimed_at TEXT,
  tint INT,
  created_at TEXT,
  created_by TEXT,
  updated_at TEXT,
  updated_by TEXT,
  client_updated_at TEXT,
  deleted_at TEXT,
  deleted_by TEXT,
  seq INT NOT NULL DEFAULT 0,
  sync_state TEXT NOT NULL DEFAULT 'synced'
) AS LocalMember;

CREATE INDEX group_members_group ON group_members (group_id);

CREATE TABLE expenses (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  kind TEXT NOT NULL DEFAULT 'expense',
  description TEXT NOT NULL,
  notes TEXT,
  category TEXT NOT NULL DEFAULT 'other.general',
  date TEXT NOT NULL,
  currency TEXT NOT NULL,
  total INT NOT NULL,
  payers TEXT NOT NULL,
  shares TEXT NOT NULL,
  split_kind TEXT NOT NULL DEFAULT 'equal',
  split_values TEXT,
  fx_rate TEXT,
  fx_rate_date TEXT,
  fx_source TEXT,
  fx_currency TEXT,
  fx_total INT,
  fx_payers TEXT,
  fx_shares TEXT,
  receipt_path TEXT,
  recurring_id TEXT,
  source TEXT NOT NULL DEFAULT 'app',
  created_at TEXT,
  created_by TEXT,
  updated_at TEXT,
  updated_by TEXT,
  client_updated_at TEXT,
  deleted_at TEXT,
  deleted_by TEXT,
  seq INT NOT NULL DEFAULT 0,
  sync_state TEXT NOT NULL DEFAULT 'synced'
) AS LocalExpense;

CREATE INDEX expenses_group_date ON expenses (group_id, date);

CREATE TABLE payments (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  from_member TEXT NOT NULL,
  to_member TEXT NOT NULL,
  amount INT NOT NULL,
  currency TEXT NOT NULL,
  date TEXT NOT NULL,
  method TEXT NOT NULL DEFAULT 'cash',
  note TEXT,
  fx_rate TEXT,
  fx_rate_date TEXT,
  fx_source TEXT,
  fx_currency TEXT,
  fx_amount INT,
  created_at TEXT,
  created_by TEXT,
  updated_at TEXT,
  updated_by TEXT,
  client_updated_at TEXT,
  deleted_at TEXT,
  deleted_by TEXT,
  seq INT NOT NULL DEFAULT 0,
  sync_state TEXT NOT NULL DEFAULT 'synced'
) AS LocalPayment;

CREATE INDEX payments_group ON payments (group_id);

CREATE TABLE comments (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  target_type TEXT NOT NULL,
  target_id TEXT NOT NULL,
  body TEXT NOT NULL,
  created_at TEXT,
  created_by TEXT,
  updated_at TEXT,
  updated_by TEXT,
  client_updated_at TEXT,
  deleted_at TEXT,
  deleted_by TEXT,
  seq INT NOT NULL DEFAULT 0,
  sync_state TEXT NOT NULL DEFAULT 'synced'
) AS LocalComment;

CREATE INDEX comments_target ON comments (target_id);

CREATE TABLE activity (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  actor_user_id TEXT,
  actor_member_id TEXT,
  type TEXT NOT NULL,
  target_type TEXT,
  target_id TEXT,
  data TEXT NOT NULL DEFAULT '{}',
  created_at TEXT,
  seq INT NOT NULL DEFAULT 0
) AS LocalActivity;

CREATE INDEX activity_group_seq ON activity (group_id, seq);

-- Derived per-member parts of each expense, rebuilt with every expense write or pull (§2).
CREATE TABLE expense_parts (
  expense_id TEXT NOT NULL,
  group_id TEXT NOT NULL,
  member_id TEXT NOT NULL,
  currency TEXT NOT NULL,
  paid INT NOT NULL DEFAULT 0,
  owed INT NOT NULL DEFAULT 0,
  fx_currency TEXT,
  fx_paid INT,
  fx_owed INT,
  PRIMARY KEY (expense_id, member_id)
) AS ExpensePart;

CREATE INDEX expense_parts_group ON expense_parts (group_id, currency);

CREATE TABLE outbox (
  seq INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  mutation_id TEXT NOT NULL UNIQUE,
  entity TEXT NOT NULL,
  op TEXT NOT NULL,
  record_id TEXT NOT NULL,
  group_id TEXT NOT NULL,
  payload TEXT NOT NULL,
  client_updated_at TEXT NOT NULL,
  created_at TEXT NOT NULL,
  attempts INT NOT NULL DEFAULT 0,
  last_error TEXT,
  status TEXT NOT NULL DEFAULT 'queued'
) AS OutboxItem;

CREATE INDEX outbox_record ON outbox (record_id);

CREATE TABLE sync_cursors (
  scope TEXT NOT NULL PRIMARY KEY,
  seq INT NOT NULL DEFAULT 0
) AS SyncCursor;

CREATE TABLE sync_meta (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
) AS SyncMetaEntry;

CREATE TABLE pending_uploads (
  id TEXT NOT NULL PRIMARY KEY,
  bucket TEXT NOT NULL,
  local_path TEXT NOT NULL,
  remote_path TEXT NOT NULL,
  record_id TEXT NOT NULL,
  attempts INT NOT NULL DEFAULT 0
) AS PendingUpload;

-- Edit-history cache (phase 12, S-130): record_versions rows of one record, fetched when its history opens
-- (append-only on the server, so rows are cached by id). Columns as on the server.
CREATE TABLE record_versions (
  id INT NOT NULL PRIMARY KEY,
  table_name TEXT NOT NULL,
  record_id TEXT NOT NULL,
  group_id TEXT NOT NULL,
  op TEXT NOT NULL,
  snapshot TEXT NOT NULL,
  changed_by TEXT,
  changed_at TEXT NOT NULL,
  client_updated_at TEXT,
  seq INT NOT NULL DEFAULT 0
) AS LocalVersion;

CREATE INDEX record_versions_record ON record_versions (record_id, seq);

-- Bell (phase 13, S-142): the signed-in person's notifications as the server sent them (only rows shown in
-- the app), fetched by seq; read_pending = marked read on this phone, not on the server yet.
CREATE TABLE notifications (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT,
  activity_id TEXT,
  kind TEXT NOT NULL,
  type TEXT NOT NULL,
  title TEXT NOT NULL,
  body TEXT NOT NULL,
  data TEXT NOT NULL DEFAULT '{}',
  read_at TEXT,
  created_at TEXT,
  seq INT NOT NULL DEFAULT 0,
  read_pending INT NOT NULL DEFAULT 0
) AS LocalNotification;

CREATE INDEX notifications_seq ON notifications (seq);

-- Notification settings of the signed-in person (one row, key 'me'): kinds {kind: {push, inapp}} and muted group
-- ids as JSON text; sync_state 'pending' until upsert_notification_settings succeeds.
CREATE TABLE notification_settings (
  "key" TEXT NOT NULL PRIMARY KEY,
  kinds TEXT NOT NULL DEFAULT '{}',
  muted_group_ids TEXT NOT NULL DEFAULT '[]',
  sync_state TEXT NOT NULL DEFAULT 'synced'
) AS LocalNotificationSettings;

-- Cache of the server's `fx_rates` (05 §6, phase 14): units of `currency` per 1 EUR on `date`, rate as exact
-- decimal TEXT. Pulled by FxRatesRepository (not the change feed: the table is shared, not group-scoped).
CREATE TABLE fx_rates (
  date TEXT NOT NULL,
  currency TEXT NOT NULL,
  rate TEXT NOT NULL,
  fetched_at TEXT,
  PRIMARY KEY (date, currency)
) AS LocalFxRate;

CREATE INDEX fx_rates_currency_date ON fx_rates (currency, date);

-- Recurring bills (phase 16, 08 #12, S-170): repeat rules as on the server; `template` = the expense fields
-- of every copy (TEXT JSON). The server adds the copies (expenses with source 'recurring') and keeps next_date;
-- a pending row shows the phone's own guess until the pull brings the server's.
CREATE TABLE recurring_templates (
  id TEXT NOT NULL PRIMARY KEY,
  group_id TEXT NOT NULL,
  expense_id TEXT,
  "interval" TEXT NOT NULL,
  anchor_date TEXT NOT NULL,
  next_date TEXT,
  ends_on TEXT,
  active BOOLEAN NOT NULL DEFAULT TRUE,
  template TEXT NOT NULL,
  created_at TEXT,
  created_by TEXT,
  updated_at TEXT,
  updated_by TEXT,
  client_updated_at TEXT,
  deleted_at TEXT,
  deleted_by TEXT,
  seq INT NOT NULL DEFAULT 0,
  sync_state TEXT NOT NULL DEFAULT 'synced'
) AS LocalRecurring;

CREATE INDEX recurring_templates_group ON recurring_templates (group_id);
CREATE INDEX recurring_templates_expense ON recurring_templates (expense_id);

-- Offline search (#34, phase 16, S-175): one row per live expense, rebuilt with every expense write or pull and
-- when member names change (lib/data/local/daos/search_index_dao.dart).
CREATE VIRTUAL TABLE expense_search USING fts5(
  expense_id UNINDEXED,
  group_id UNINDEXED,
  description,
  notes,
  member_names,
  amount_text
);
