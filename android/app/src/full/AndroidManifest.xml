<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- `full` flavour only (D-028): the payment bubble (phase 18b, X4). Google Play Protect's enhanced fraud
         protection in India blocks sideloaded APKs that declare these, so the default `standard` flavour has none. -->
    <!-- "Display over other apps", asked only when the user turns the bubble on. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <application>
        <!-- Off by default; the master switch enables these components, the user then grants notification access /
             accessibility in Android settings. Parsed fields only, on the phone. -->
        <service
            android:name=".capture.PaymentNotificationListener"
            android:enabled="false"
            android:exported="true"
            android:label="@string/capture_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <service
            android:name=".capture.SmartCaptureService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/capture_smart_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/smart_capture_service"/>
        </service>
        <receiver android:name=".capture.CaptureActionReceiver" android:exported="false"/>
    </application>
    <queries>
        <!-- Which allow-listed payment apps are installed (per-app switches). -->
        <package android:name="com.google.android.apps.nbu.paisa.user"/>
        <package android:name="com.phonepe.app"/>
        <package android:name="net.one97.paytm"/>
        <package android:name="in.org.npci.upiapp"/>
        <package android:name="in.amazon.mShop.android.shopping"/>
        <package android:name="com.dreamplug.androidapp"/>
        <package android:name="money.super.payments"/>
        <package android:name="com.whatsapp"/>
        <package android:name="com.google.android.apps.messaging"/>
        <package android:name="com.samsung.android.messaging"/>
        <package android:name="com.hdfcbank.android.now"/>
        <package android:name="com.hdfcbank.payzapp"/>
        <package android:name="com.sbi.lotusintouch"/>
        <package android:name="com.csam.icici.bank.imobile"/>
        <package android:name="com.axis.mobile"/>
        <package android:name="com.kotak811mobilebankingapp.instantsavingsupiscanandpayrecharge"/>
        <package android:name="com.msf.kbank.mobile"/>
        <package android:name="com.Version1"/>
        <package android:name="com.bankofbaroda.mconnect"/>
        <package android:name="com.canarabank.mobility"/>
    </queries>
</manifest>
