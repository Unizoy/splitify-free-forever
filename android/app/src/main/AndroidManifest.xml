<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Supabase, exchange rates and push need the network in release builds too. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Android 13+: asked after the pre-prompt sheet (phase 13, 08 #19). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Payment bubble (phase 18b, X4): "Display over other apps", asked only when the user turns the bubble on. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <application
        android:label="Splitify Free Forever"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Launcher label: the full name does not fit under an icon ("Splitify Free …"); final QA S-257. -->
        <activity
            android:name=".MainActivity"
            android:label="Splitify"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="splitify"/>
            </intent-filter>
        </activity>
        <!-- Payment bubble (phase 18b, X4): off by default; the master switch enables these components, the user
             then grants notification access / accessibility in Android settings. Parsed fields only, on the phone. -->
        <service
            android:name=".capture.PaymentNotificationListener"
            android:enabled="false"
            android:exported="true"
            android:label="@string/capture_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <service
            android:name=".capture.SmartCaptureService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/capture_smart_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/smart_capture_service"/>
        </service>
        <receiver android:name=".capture.CaptureActionReceiver" android:exported="false"/>
        <!-- FCM pushes that arrive in the background: status-bar icon and the fallback channel (the server
             sets android.notification.channel_id to the kind; the app creates one channel per kind). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_splitify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="expenses" />
        <!-- Home-screen balance widgets (X3, phase 18): 2x2 and 4x2, drawn by BalanceWidget.kt. -->
        <receiver android:name=".BalanceWidgetSmall" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_small_info" />
        </receiver>
        <receiver android:name=".BalanceWidgetWide" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balance_wide_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Payment bubble: which allow-listed payment apps are installed (per-app switches). -->
        <package android:name="com.google.android.apps.nbu.paisa.user"/>
        <package android:name="com.phonepe.app"/>
        <package android:name="net.one97.paytm"/>
        <package android:name="in.org.npci.upiapp"/>
        <package android:name="in.amazon.mShop.android.shopping"/>
        <package android:name="com.dreamplug.androidapp"/>
        <package android:name="money.super.payments"/>
        <package android:name="com.whatsapp"/>
        <package android:name="com.google.android.apps.messaging"/>
        <package android:name="com.samsung.android.messaging"/>
        <package android:name="com.hdfcbank.android.now"/>
        <package android:name="com.hdfcbank.payzapp"/>
        <package android:name="com.sbi.lotusintouch"/>
        <package android:name="com.csam.icici.bank.imobile"/>
        <package android:name="com.axis.mobile"/>
        <package android:name="com.kotak811mobilebankingapp.instantsavingsupiscanandpayrecharge"/>
        <package android:name="com.msf.kbank.mobile"/>
        <package android:name="com.Version1"/>
        <package android:name="com.bankofbaroda.mconnect"/>
        <package android:name="com.canarabank.mobility"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
